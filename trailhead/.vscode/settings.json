{
  "files.exclude": {
    "**/__pycache__": true,
    ".ruff_cache": true,
    ".venv": true,
    ".python-version": true,
    ".pytest_cache": true,
    "pyproject.toml": true,
    "README.md": true,
    "uv.lock": true,
    ".vscode": true,
    "tools": true
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "python.testing.pytestArgs": [
    "."
  ],
  "ruff.lint.ignore": ["PLR1730", "PIE790"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
