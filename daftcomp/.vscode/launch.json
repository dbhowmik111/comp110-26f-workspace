{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Daftcomp: Debug Rehearsal",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/list_utils/rehearsal.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    },
    {
      "name": "Daftcomp: Debug Unlocked Song",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/list_utils/song.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    }
  ]
}
